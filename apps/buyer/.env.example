# Supabase connection values, from your project's dashboard
# (Project Settings > API). Copy this file to `.env` for your own reference;
# the app itself never reads `.env` directly, these are passed in explicitly
# with --dart-define (see README.md "Supabase setup").

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Clerk (spec 0004). Only the publishable key is a client value passed via
# --dart-define; it is safe to ship in the app. Clerk's secret key and the
# webhook signing secret are server-side only (Supabase Edge Function secrets),
# never placed here or in any --dart-define.
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
